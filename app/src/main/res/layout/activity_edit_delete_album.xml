<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:backgroundColor="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MANAGE ALBUM"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="32dp"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EDIT TITLE"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_edit_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/edit_text"
        android:paddingLeft="12dp"
        android:layout_marginBottom="20dp"
        android:inputType="text"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EDIT DESCRIPTION"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_edit_desc"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:gravity="top"
        android:layout_marginBottom="32dp"
        android:inputType="textMultiLine"/>

    <Button
        android:id="@+id/btn_update_album"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="SAVE CHANGES"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_delete_album"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="DELETE ALBUM"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>